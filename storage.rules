rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Tenant logos — only tenant admin can upload
    match /tenants/{tenantId}/logo/{filename} {
      allow read: if request.auth != null && request.auth.token.tenantId == tenantId;
      allow write: if request.auth != null
        && request.auth.token.tenantId == tenantId
        && request.auth.token.role == 'tenant_admin'
        && request.resource.size < 2 * 1024 * 1024 // 2MB max
        && request.resource.contentType.matches('image/.*');
    }

    // No other paths allowed
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
